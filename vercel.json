{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/smartleads/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/smartleads/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/smartleads", "destination": "/index.html" },
    { "source": "/smartleads/", "destination": "/index.html" },
    { "source": "/smartleads/:path*", "destination": "/index.html" }
  ]
}
